{
  "manifest_version": 3,
  "name": "foxlend demo",
  "version": "0.1.1",
  "description": "Lend one login to an AI agent in its own Firefox container, and take it back.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxlend@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "contextualIdentities",
    "browsingData",
    "tabs",
    "tabHide",
    "webRequest",
    "webRequestBlocking",
    "proxy",
    "privacy",
    "publicSuffix"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "foxlend",
    "default_panel": "sidebar.html",
    "open_at_install": true
  }
}
